{
  "name": "worker",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migration:new": "wrangler d1 migrations create DB",
    "db:seed": "wrangler d1 execute DB --local --file=db/seed.sql",
    "db:seed:fixtures": "wrangler d1 execute DB --local --file=db/seed.fixtures.sql",
    "db:query": "wrangler d1 execute DB --local --command",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
